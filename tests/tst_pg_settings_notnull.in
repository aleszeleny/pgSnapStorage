-- Test NOT NULL constraints for pg_settings table
SELECT col_not_null( :'tap_namespace', :'tap_table_name', 'hash'
  , format('Column %I.%I.hash should be NOT NULL', :'tap_namespace', :'tap_table_name') );
SELECT col_not_null( :'tap_namespace', :'tap_table_name', 'name'
  , format('Column %I.%I.name should be NOT NULL', :'tap_namespace', :'tap_table_name') );
SELECT col_not_null( :'tap_namespace', :'tap_table_name', 'setting'
  , format('Column %I.%I.setting should be NOT NULL', :'tap_namespace', :'tap_table_name') );
