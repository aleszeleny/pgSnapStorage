-- Test NOT NULL constraints for instance table
SELECT col_not_null( :'tap_namespace', :'tap_table_name', 'system_id'
  , format('Column %I.%I.system_id should be NOT NULL', :'tap_namespace', :'tap_table_name') );
SELECT col_not_null( :'tap_namespace', :'tap_table_name', 'cluster_name'
  , format('Column %I.%I.cluster_name should be NOT NULL', :'tap_namespace', :'tap_table_name') );
SELECT col_not_null( :'tap_namespace', :'tap_table_name', 'listen_port'
  , format('Column %I.%I.listen_port should be NOT NULL', :'tap_namespace', :'tap_table_name') );
SELECT col_not_null( :'tap_namespace', :'tap_table_name', 'registration_time'
  , format('Column %I.%I.registration_time should be NOT NULL', :'tap_namespace', :'tap_table_name') );
SELECT col_not_null( :'tap_namespace', :'tap_table_name', 'lastmod'
  , format('Column %I.%I.lastmod should be NOT NULL', :'tap_namespace', :'tap_table_name') );
